{
  "id": "clawpanel-official-gateway",
  "name": "ClawPanel official Gateway",
  "providers": ["clawpanel-official-gateway"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agents"],
    "properties": {
      "agents": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memberId", "modelId"],
          "properties": {
            "memberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
            "modelId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" }
          }
        }
      }
    }
  }
}
